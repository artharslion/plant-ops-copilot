# Copy this file to .env next to compose.yaml. Do not share real credentials.
# Database password: letters, digits, underscores and hyphens only.
POSTGRES_PASSWORD=
# 12+ characters, including uppercase, lowercase, digit and symbol.
# Quote values containing $ or # with single quotes.
DEMO_PASSWORD=

DOCKERHUB_NAMESPACE=artharslion
PLANTOPS_VERSION=2cf19c8
INDUSTRIALSIM_VERSION=3d5e7c0
WEB_PORT=8080
SIMULATOR_PORT=8081

# Fake works without external AI access or an API key.
AI_PROVIDER=Fake
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
