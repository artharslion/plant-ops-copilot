FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:4beef5b8919dcaa2dc924233bd069257e883cc7a061e09088a97d152d6a48510 AS build
WORKDIR /source
# The container SDK is pinned by image digest independently of the host SDK.
COPY Directory.Build.props .editorconfig ./
COPY src/ src/
RUN dotnet restore src/PlantOps.Api/PlantOps.Api.csproj --locked-mode \
    && dotnet restore src/PlantOps.Worker/PlantOps.Worker.csproj --locked-mode
RUN dotnet publish src/PlantOps.Api/PlantOps.Api.csproj -c Release --no-restore -o /out/api /p:UseAppHost=false \
    && dotnet publish src/PlantOps.Worker/PlantOps.Worker.csproj -c Release --no-restore -o /out/worker /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac AS runtime
USER root
RUN mkdir -p /var/lib/plantops/documents /home/app/.aspnet/DataProtection-Keys \
    && chown -R app:app /var/lib/plantops /home/app
WORKDIR /app
COPY deploy/healthcheck.sh ./healthcheck.sh
ENV ASPNETCORE_HTTP_PORTS=8080 \
    Documents__StorageRoot=/var/lib/plantops/documents
EXPOSE 8080
USER app
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=6 \
    CMD ["bash", "/app/healthcheck.sh"]

FROM runtime AS api
COPY --from=build /out/api/ ./
ENTRYPOINT ["dotnet", "PlantOps.Api.dll"]

FROM runtime AS worker
COPY --from=build /out/worker/ ./
ENTRYPOINT ["dotnet", "PlantOps.Worker.dll"]
