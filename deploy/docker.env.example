# Copy to deploy/.env.docker. Keep actual credentials out of Git.
# Database password: use only letters, digits, underscores and hyphens.
POSTGRES_PASSWORD=
# Demo accounts require 12+ characters with uppercase/lowercase/digit/symbol.
DEMO_PASSWORD=
WEB_PORT=8080

# Optional: Fake does not contact an external model.
AI_PROVIDER=Fake
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
