{
  "name": "plantops-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "generate:api": "openapi-typescript http://127.0.0.1:5080/openapi/v1.json -o src/generated/api.d.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests scripts vite.config.ts eslint.config.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.6",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  }
}
